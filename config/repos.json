{
  "organization": "OpenAgriNet",

  "sources": [
    {
      "type": "query",
      "query": "props.project-name:\"OAN DPG\"",
      "tags": ["DPG"],
      "fallback": ["decision-support-system", "discovery-service", "helmcharts", "infra-automation", "network-adapter"]
    },
    {
      "type": "project",
      "org": "OpenAgriNet",
      "number": 9,
      "tags": ["DPG"],
      "enabled": false
    }
  ],

  "repositories": [
    { "name": "network-adapter", "branch": "development" },
    { "name": "discovery-service", "branch": "development" },
    { "name": "helmcharts", "branch": "development" },
    { "name": "decision-support-system", "branch": "main" },
    { "name": "knowledge-provider", "branch": "main" },
    { "name": "experience-api", "branch": "main" },
    { "name": "experience-ui", "branch": "main" },
    { "name": "infra-automation", "branch": "main" }
  ],

  "exclude": ["engineering-tracker"],

  "defaults": { "security_workflow": "security.yml" },
  "workflow_names": ["CI"],
  "artifact_name_hints": [],

  "releases": {
    "sources": ["branch", "tag", "release"],
    "branch_prefix": "release-",
    "tag_pattern": "^v?(?P<version>\\d+(?:\\.\\d+)*(?:-[0-9A-Za-z.]+)?)$",
    "include_prereleases": true,
    "max_versions": 10
  }
}
