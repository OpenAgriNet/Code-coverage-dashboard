{
  "organization": "OpenAgriNet",

  "sources": [
    {
      "type": "query",
      "query": "props.project-name:\"OAN DPG\"",
      "tags": ["DPG"]
    }
  ],

  "exclude": ["engineering-tracker", "Code-coverage-dashboard"],

  "repositories": [
    { "name": "infra-automation" }
  ],

  "branches": {
    "development": "^(dev|develop|development)$"
  },

  "release_sets": [],

  "releases": {
    "sources": ["branch", "tag", "release"],
    "branch_prefix": "release-",
    "tag_pattern": "^v?(?P<version>\\d+(?:\\.\\d+)*(?:-[0-9A-Za-z.]+)?)$",
    "include_prereleases": true,
    "max_versions": 10
  },

  "coverage": {
    "workflow_names": ["CI"],
    "artifact_name_hints": []
  },

  "security": {
    "workflow": "security.yml"
  },

  "stack": {
    "ignore_languages": ["Markdown", "JSON", "YAML", "TOML", "INI", "CSV", "Text", "SVG", "XML", "Jinja", "Smarty", "HTML", "CSS", "SCSS", "Shell", "Dockerfile", "Makefile", "AMPL", "JSONiq"],
    "ignore_techs": ["github", "github.actions", "github.pages", "codecov", "bash", "docker", "eslint", "prettier", "npm", "nodejs", "vitest", "css", "jsx", "javascript", "typescript", "python", "golang", "openapi", "opentelemetry", "lucideicons", "radixui", "shadcn", "segment"],
    "max_languages": 3,
    "min_share": 0.1,
    "max_techs": 6
  },

  "dependencies": {
    "image_sources": {
      "clickhouse/clickhouse-server": "ClickHouse/ClickHouse",
      "jaegertracing/all-in-one": "jaegertracing/jaeger",
      "openzipkin/zipkin": "openzipkin/zipkin",
      "grafana/grafana": "grafana/grafana",
      "grafana/loki": "grafana/loki",
      "otel/opentelemetry-collector-contrib": "open-telemetry/opentelemetry-collector-contrib",
      "minio/minio": "minio/minio",
      "minio/mc": "minio/mc",
      "cgr.dev/chainguard/minio": "minio/minio",
      "temporalio/auto-setup": "temporalio/temporal",
      "temporalio/ui": "temporalio/ui",
      "docker.langfuse.com/langfuse/langfuse": "langfuse/langfuse",
      "docker.langfuse.com/langfuse/langfuse-worker": "langfuse/langfuse"
    },
    "image_licenses": {
      "postgres": "PostgreSQL",
      "pgvector/pgvector": "PostgreSQL"
    }
  },

  "licenses": {
    "no_license": "red",
    "green": ["MIT", "BSD-2-Clause", "BSD-3-Clause", "ISC", "Apache-2.0", "Zlib", "BSL-1.0", "PSF-2.0", "Python-2.0", "Unlicense", "CC0-1.0", "0BSD"],
    "yellow": ["MPL-2.0", "LGPL-*", "EPL-2.0", "CDDL-1.*"],
    "red": ["GPL-*", "AGPL-*", "SSPL-1.0", "BUSL-1.1", "Elastic-2.0", "Commons-Clause", "CC-BY-NC-*", "JSON", "non-standard", "Other"]
  }
}
